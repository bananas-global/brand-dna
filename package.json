{
  "name": "brand-dna",
  "version": "0.2.0",
  "description": "An opinionated, AI-friendly brand source of truth and public brandbook.",
  "license": "MIT",
  "homepage": "https://github.com/bananas-global/brand-dna#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bananas-global/brand-dna.git"
  },
  "bugs": {
    "url": "https://github.com/bananas-global/brand-dna/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "brand",
    "brandbook",
    "design-system",
    "ai",
    "design-tokens"
  ],
  "bin": {
    "brand-dna": "./bin/brand-dna.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "src/App.tsx",
    "src/color-scale.ts",
    "src/editor.ts",
    "src/google-fonts.ts",
    "src/main.tsx",
    "src/styles.css",
    "src/vite-env.d.ts",
    "public/brand/",
    "index.html",
    "vite.config.ts",
    "brand-dna.config.json",
    "tsconfig.json",
    "brand-dna.config.schema.json",
    "README.md",
    "START-HERE.md",
    "TRADEMARKS.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run build && vitest run && node --test tests/*.test.mjs",
    "lint": "eslint .",
    "validate": "node scripts/validate-brand-dna.mjs",
    "brand-dna": "node bin/brand-dna.mjs",
    "release:check": "npm run lint && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run release:check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^29.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.10"
  },
  "type": "module"
}
