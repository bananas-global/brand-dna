{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brand-dna.schema.json",
  "title": "Minimum Viable Brand DNA",
  "type": "object",
  "$defs": {
    "colorScaleLink": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["linked", "custom"] },
        "settings": { "$ref": "#/properties/visual/properties/colorScale" }
      }
    },
    "fontRole": {
      "type": "object",
      "required": ["family", "source", "weight"],
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 }
      }
    },
    "additionalFontRole": {
      "type": "object",
      "required": ["name", "family", "source", "weight", "role"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "shadowToken": {
  "type": "object",
  "additionalProperties": false,
      "required": ["distance", "angle", "blur", "spread", "colorStop", "opacity"],
      "additionalProperties": false,
      "properties": {
        "distance": { "type": "number", "minimum": 0, "maximum": 48 },
        "angle": { "type": "number", "minimum": 0, "maximum": 360 },
        "blur": { "type": "number", "minimum": 0, "maximum": 96 },
        "spread": { "type": "number", "minimum": -16, "maximum": 32 },
        "colorStop": { "type": "integer", "minimum": 0, "maximum": 1000, "multipleOf": 50 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.01 }
      }
    }
  },
  "required": [
    "meta",
    "essence",
    "voice",
    "visual",
    "positioning",
    "imagery",
    "iconography",
    "informationAndData",
    "accessibility",
    "channels",
    "provenance"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "brandName", "language", "status", "version"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "brandName": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "status": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "essence": {
      "type": "object",
      "required": ["purpose"],
      "additionalProperties": false,
      "properties": {
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "voice": {
      "type": "object",
      "required": ["dimensions", "say", "dontSay"],
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["name", "left", "right", "value", "description"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "left": { "type": "string", "minLength": 1 },
              "right": { "type": "string", "minLength": 1 },
              "value": { "type": "integer", "minimum": 0, "maximum": 100 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "say": { "type": "string", "minLength": 1 },
        "dontSay": { "type": "string", "minLength": 1 }
      }
    },
    "positioning": {
      "type": "object",
      "required": ["statement", "primaryAudience", "influencingAudience"],
      "additionalProperties": false,
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "primaryAudience": { "type": "string", "minLength": 1 },
        "influencingAudience": { "type": "string", "minLength": 1 }
      }
    },
    "visual": {
      "type": "object",
      "required": ["signatureRule", "colors", "semanticColors", "colorScale", "colorScales", "typography", "borders", "shadows"],
      "properties": {
        "signatureRule": { "type": "string", "minLength": 1 },
        "colors": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["name", "value", "mode", "role"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "mode": { "enum": ["source", "complementary", "derived", "custom"] },
              "role": { "type": "string" }
            }
          }
        },
        "additionalColors": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["name", "value", "role"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },
        "semanticColors": {
          "type": "object",
          "required": ["paper", "ink", "border"],
          "properties": {
            "paper": {
              "type": "object",
              "required": ["source", "stop", "role"],
              "properties": {
                "source": { "const": "Signal" },
                "stop": { "type": "integer", "minimum": 0, "maximum": 450, "multipleOf": 50 },
                "role": { "type": "string" }
              }
            },
            "ink": {
              "type": "object",
              "required": ["source", "stop", "role"],
              "properties": {
                "source": { "const": "Signal" },
                "stop": { "type": "integer", "minimum": 550, "maximum": 1000, "multipleOf": 50 },
                "role": { "type": "string" }
              }
            },
            "border": {
              "type": "object",
              "required": ["source", "mode", "opacity", "value", "role"],
              "properties": {
                "source": { "const": "Ink" },
                "mode": { "const": "ink-alpha" },
                "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                "value": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                "role": { "type": "string" }
              }
            }
          }
        },
        "colorScale": {
          "type": "object",
          "required": ["lightSteps", "darkSteps", "hueMultiplier", "hueFlip", "saturationMultiplier", "saturationFlip", "contrastColorMode", "contrast"],
          "properties": {
            "lightSteps": { "const": 10 },
            "darkSteps": { "const": 10 },
            "hueMultiplier": { "type": "number", "minimum": 1, "maximum": 2 },
            "hueFlip": { "type": "boolean" },
            "saturationMultiplier": { "type": "number", "minimum": 1, "maximum": 2 },
            "saturationFlip": { "type": "boolean" },
            "contrastColorMode": { "const": "highest-contrast-endpoint" },
            "contrast": { "type": "number", "minimum": 0.5, "maximum": 1.25 }
          }
        },
        "colorScales": {
          "type": "object",
          "required": ["Accent", "Success", "Warning", "Error"],
          "additionalProperties": false,
          "properties": {
            "Accent": { "$ref": "#/$defs/colorScaleLink" },
            "Success": { "$ref": "#/$defs/colorScaleLink" },
            "Warning": { "$ref": "#/$defs/colorScaleLink" },
            "Error": { "$ref": "#/$defs/colorScaleLink" }
          }
        },
        "typography": {
          "type": "object",
          "required": ["headings", "body", "utility"],
          "additionalProperties": false,
          "properties": {
            "headings": { "$ref": "#/$defs/fontRole" },
            "body": { "$ref": "#/$defs/fontRole" },
            "utility": { "$ref": "#/$defs/fontRole" },
            "additional": {
              "type": "array",
              "maxItems": 12,
              "items": { "$ref": "#/$defs/additionalFontRole" }
            }
          }
        },
        "borders": {
          "type": "object",
          "required": ["thickness", "radius", "buttonPill"],
          "additionalProperties": false,
          "properties": {
            "thickness": { "enum": ["thin", "medium", "bold"] },
            "radius": { "type": "number", "minimum": 0, "maximum": 3, "multipleOf": 0.1 },
            "buttonPill": { "type": "boolean" }
          }
        },
        "shadows": {
          "type": "object",
          "required": ["base", "multiplier"],
          "additionalProperties": false,
          "properties": {
            "base": { "$ref": "#/$defs/shadowToken" },
            "multiplier": { "type": "number", "minimum": 1, "maximum": 3, "multipleOf": 0.1 }
          }
        }
      }
    },
    "imagery": {
      "type": "object",
      "required": ["principle", "directions", "do", "avoid"],
      "additionalProperties": false,
      "properties": {
        "principle": { "type": "string", "minLength": 1 },
        "directions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "asset", "description", "prompt"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "asset": { "type": "string", "pattern": "^[^/]+\\.(avif|jpe?g|png|svg|webp)$" },
              "description": { "type": "string", "minLength": 1 },
              "prompt": { "type": "string", "minLength": 1 }
            }
          }
        },
        "do": { "type": "string" },
        "avoid": { "type": "string" }
      }
    },
    "iconography": {
      "type": "object",
      "required": ["principle", "library", "variant", "source"],
      "properties": {
        "principle": { "type": "string" },
        "library": { "enum": ["Lucide", "Phosphor", "Material Symbols", "Heroicons", "Font Awesome Free"] },
        "variant": { "type": "string" },
        "source": { "type": "string", "format": "uri" }
      }
    },
    "informationAndData": { "type": "object" },
    "accessibility": { "type": "object" },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "job", "rule"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "job": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["evidence", "decisions", "proposals", "missing"],
      "properties": {
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "proposals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "missing": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
